{
  "name": "harbor",
  "version": "0.1.0",
  "description": "Centralized local development environment platform for macOS",
  "main": "./out/main/index.js",
  "author": "Harbor",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/smoke.cjs --log-level=warning && node node_modules/.cache/smoke.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac",
    "verify:slice": "esbuild scripts/verify-slice.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/verify-slice.cjs --log-level=warning && node node_modules/.cache/verify-slice.cjs",
    "verify:service": "esbuild scripts/verify-service.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/verify-service.cjs --log-level=warning && node node_modules/.cache/verify-service.cjs",
    "verify:catalog": "esbuild scripts/verify-catalog.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/verify-catalog.cjs --log-level=warning && node node_modules/.cache/verify-catalog.cjs",
    "verify:intelligence": "esbuild scripts/verify-intelligence.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/verify-intelligence.cjs --log-level=warning && node node_modules/.cache/verify-intelligence.cjs",
    "doctor:release": "esbuild scripts/check-release.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-release.cjs --log-level=warning && node node_modules/.cache/check-release.cjs",
    "icon": "python3 scripts/make-icon.py",
    "verify:php": "esbuild scripts/verify-php-site.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/verify-php-site.cjs --log-level=warning && node node_modules/.cache/verify-php-site.cjs",
    "verify:processes": "esbuild scripts/verify-processes.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/verify-processes.cjs --log-level=warning && node node_modules/.cache/verify-processes.cjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "esbuild": "^0.25.0"
  }
}
